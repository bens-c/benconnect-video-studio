# Set long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REPLICATE_API_TOKEN=
# Example: owner/model; choose a video model available to your Replicate account
REPLICATE_MODEL=
# Model-specific optional extra input fields, e.g. {"duration":5,"aspect_ratio":"16:9"}
REPLICATE_INPUT_JSON={}
# Exact public site origin (used for cross-origin request protection)
PUBLIC_ORIGIN=https://video.benconnect.cyou
# Comma-separated video output domains (restrict remote downloads)
ALLOWED_VIDEO_HOSTS=replicate.delivery,*.replicate.delivery,replicate.com,*.replicate.com
COOKIE_SECURE=true
MAX_UPLOAD_MB=100